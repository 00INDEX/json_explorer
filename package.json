{
  "name": "json-notebook",
  "displayName": "JSON Notebook",
  "description": "Run jq queries against the open JSON file with field autocomplete, and view the result in a new tab.",
  "version": "0.1.5",
  "publisher": "00index",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/00INDEX/json_explorer.git"
  },
  "bugs": {
    "url": "https://github.com/00INDEX/json_explorer/issues"
  },
  "homepage": "https://github.com/00INDEX/json_explorer#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "galleryBanner": {
    "color": "#4f56e8",
    "theme": "dark"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "json",
    "jq",
    "query",
    "explorer",
    "unescape"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "jsonNotebook",
          "title": "JSON Notebook",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "jsonNotebook": [
        {
          "id": "jsonNotebook.inputView",
          "name": "Query",
          "type": "webview",
          "contextualTitle": "JSON Notebook"
        }
      ]
    },
    "commands": [
      {
        "command": "jsonNotebook.focusInput",
        "title": "JSON Notebook: Focus Query Input"
      }
    ],
    "configuration": {
      "title": "JSON Notebook",
      "properties": {
        "jsonNotebook.jqPath": {
          "type": "string",
          "default": "jq",
          "description": "Path to the jq executable. Use an absolute path if jq is not on your PATH."
        },
        "jsonNotebook.rawOutput": {
          "type": "boolean",
          "default": true,
          "description": "Pass -r to jq so string results are printed raw (unescaped), which is ideal for reading escaped text."
        },
        "jsonNotebook.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to jq before the filter (e.g. [\"-S\"] to sort keys)."
        },
        "jsonNotebook.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "Open the result document beside the source file instead of replacing it."
        },
        "jsonNotebook.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reveal the JSON Notebook panel when a JSON file becomes active."
        },
        "jsonNotebook.maxCompletionItems": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of field suggestions to show in the autocomplete dropdown."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package -o json-explorer.vsix",
    "publish": "ovsx publish json-explorer.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.4.0"
  }
}
